[Unit]
Description=Watcher poller (connectors, discovery, LLDP topology, trap/syslog receivers)
Documentation=https://github.com/mliad313sn/Watcher
After=network-online.target watcher-api.service
Wants=network-online.target
PartOf=watcher.target

[Service]
Type=simple
User=watcher
Group=watcher
EnvironmentFile=/etc/watcher/watcher.env
WorkingDirectory=/opt/watcher
ExecStart=/usr/bin/node /opt/watcher/apps/poller/src/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
# The trap (162/udp) and syslog (514/udp) receivers need a privileged port.
# Granting exactly that capability is the alternative to running the poller
# as root; both are ambient so the unprivileged process keeps it after the
# user switch. Harmless when TRAP_PORT/SYSLOG_PORT are unset — nothing binds.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/watcher /tmp
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target watcher.target
