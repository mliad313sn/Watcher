#!/usr/bin/env bash
# watcherd — Watcher service supervisor for hosts without a usable systemd
# (containers, minimal images). Same lifecycle verbs as systemctl:
#
#   watcherd start|stop|restart|status|logs [service]
#
# Services: api poller [agent] [nagios-sim]
#   - agent runs when /etc/watcher/agent.env exists
#   - nagios-sim (demo heartbeat writer) runs when NAGIOS_SIM=1 in watcher.env
#
# Each service runs under a restart loop (3s backoff, like Restart=always);
# logs land in $WATCHER_LOG_DIR, pidfiles in $WATCHER_RUN_DIR.
set -u

WATCHER_HOME="${WATCHER_HOME:-/opt/watcher}"
ENV_FILE="${WATCHER_ENV:-/etc/watcher/watcher.env}"
AGENT_ENV="${WATCHER_AGENT_ENV:-/etc/watcher/agent.env}"
RUN_DIR="${WATCHER_RUN_DIR:-/var/run/watcher}"
LOG_DIR="${WATCHER_LOG_DIR:-/var/log/watcher}"
mkdir -p "$RUN_DIR" "$LOG_DIR"

# shellcheck disable=SC1090
[ -f "$ENV_FILE" ] && set -a && . "$ENV_FILE" && set +a

services() {
  local list="api poller"
  [ -f "$AGENT_ENV" ] && list="$list agent"
  [ "${NAGIOS_SIM:-0}" = "1" ] && list="$list nagios-sim"
  echo "$list"
}

cmd_for() {
  case "$1" in
    api)        echo "node $WATCHER_HOME/apps/api/src/server.js" ;;
    poller)     echo "node $WATCHER_HOME/apps/poller/src/index.js" ;;
    agent)      echo "env-file:$AGENT_ENV node $WATCHER_HOME/apps/agent/watcher-agent.mjs" ;;
    nagios-sim) echo "internal:nagios_sim" ;;
    *) return 1 ;;
  esac
}

# Demo/sandbox stand-in for a live Nagios engine: keep status.dat fresh.
nagios_sim() {
  while :; do
    printf '########################################\nprogramstatus {\n\tnagios_pid=1\n\tlast_command_check=%s\n\t}\n' \
      "$(date +%s)" > "${NAGIOS_STATUS_FILE:-/tmp/status.dat}"
    sleep 15
  done
}

pid_of() { [ -f "$RUN_DIR/$1.pid" ] && cat "$RUN_DIR/$1.pid" 2>/dev/null; }
alive() { local p; p=$(pid_of "$1"); [ -n "${p:-}" ] && kill -0 "$p" 2>/dev/null; }

start_one() {
  local svc="$1"
  if alive "$svc"; then echo "  $svc: already running (pid $(pid_of "$svc"))"; return 0; fi
  local spec; spec=$(cmd_for "$svc") || { echo "  $svc: unknown service"; return 1; }
  (
    # Supervisor loop — Restart=always, RestartSec=3.
    if [ "$spec" = "internal:nagios_sim" ]; then
      while :; do nagios_sim >>"$LOG_DIR/$svc.log" 2>&1; echo "[watcherd] $svc exited, restart in 3s" >>"$LOG_DIR/$svc.log"; sleep 3; done
    elif [ "${spec#env-file:}" != "$spec" ]; then
      local envf="${spec#env-file:}"; envf="${envf%% *}"
      local cmd="${spec#env-file:$envf }"
      while :; do
        ( set -a; . "$envf"; set +a; exec $cmd ) >>"$LOG_DIR/$svc.log" 2>&1
        echo "[watcherd] $svc exited, restart in 3s" >>"$LOG_DIR/$svc.log"; sleep 3
      done
    else
      while :; do $spec >>"$LOG_DIR/$svc.log" 2>&1; echo "[watcherd] $svc exited ($?), restart in 3s" >>"$LOG_DIR/$svc.log"; sleep 3; done
    fi
  ) &
  local sup=$!
  disown "$sup" 2>/dev/null || true
  echo "$sup" > "$RUN_DIR/$svc.pid"
  echo "  $svc: started (supervisor pid $sup, log $LOG_DIR/$svc.log)"
}

stop_one() {
  local svc="$1" p; p=$(pid_of "$svc")
  if [ -z "${p:-}" ] || ! kill -0 "$p" 2>/dev/null; then echo "  $svc: not running"; rm -f "$RUN_DIR/$svc.pid"; return 0; fi
  # Kill the supervisor's whole process group so the child dies with it.
  pkill -TERM -P "$p" 2>/dev/null
  kill -TERM "$p" 2>/dev/null
  sleep 1
  pkill -KILL -P "$p" 2>/dev/null; kill -KILL "$p" 2>/dev/null
  rm -f "$RUN_DIR/$svc.pid"
  echo "  $svc: stopped"
}

status_one() {
  local svc="$1"
  if alive "$svc"; then
    local child
    child=$(pgrep -P "$(pid_of "$svc")" | head -1)
    echo "  ● $svc  active (supervisor $(pid_of "$svc"), worker ${child:-starting})"
  else
    echo "  ○ $svc  stopped"
  fi
}

TARGETS="${2:-$(services)}"
case "${1:-}" in
  start)   echo "watcherd: starting"; for s in $TARGETS; do start_one "$s"; done ;;
  stop)    echo "watcherd: stopping"; for s in $TARGETS; do stop_one "$s"; done ;;
  restart) echo "watcherd: restarting"; for s in $TARGETS; do stop_one "$s"; start_one "$s"; done ;;
  status)  echo "watcherd: service status"; for s in $TARGETS; do status_one "$s"; done ;;
  logs)    tail -n 40 "$LOG_DIR/${2:-api}.log" ;;
  *) echo "usage: watcherd start|stop|restart|status [service] | logs <service>"; exit 2 ;;
esac
