# ── Watcher platform configuration ─────────────────────────────────────────
# Copy to .env and adjust. Every service reads only the variables it needs.

NODE_ENV=development
LOG_LEVEL=info

# ── API (Fastify) ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
# HMAC secret for JWT signing — generate with: openssl rand -hex 32
# REQUIRED in production: the API refuses to start with the default/short value.
JWT_SECRET=change-me-in-production
JWT_TTL=8h
# Comma-separated list of allowed CORS origins (the web app origins). Includes
# the compose web service (:8088) and the Vite dev server (:5173). With the
# compose `web` service the browser is same-origin, so CORS isn't exercised.
CORS_ORIGINS=http://localhost:8088,http://localhost:5173
# Public URL the browser reaches the product on — used to build one-tap mobile
# acknowledge links in notifications. Defaults to the compose web origin; set to
# your externally reachable origin in production (or :5173 for pure dev).
PUBLIC_BASE_URL=http://localhost:8088

# ── PostgreSQL (tenant / system configuration) ─────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=watcher
PG_USER=watcher
PG_PASSWORD=watcher

# ── TimescaleDB (historical performance metrics) ───────────────────────────
TSDB_HOST=localhost
TSDB_PORT=5433
TSDB_DATABASE=watcher_metrics
TSDB_USER=watcher
TSDB_PASSWORD=watcher

# ── Redis (real-time state cache, pub/sub, alert correlation) ──────────────
# REDIS_PASSWORD is consumed by docker-compose to set requirepass and build the
# authenticated REDIS_URL for the containers. For a local (non-compose) Redis,
# set REDIS_URL directly (include the password if your instance requires one).
REDIS_PASSWORD=watcher
REDIS_URL=redis://localhost:6379

# ── Single sign-on (optional) ──────────────────────────────────────────────
# OIDC authorization-code flow — works with Keycloak, Authentik, Okta,
# Entra ID, Google. Leave ISSUER empty to disable (password login remains).
SSO_OIDC_ISSUER=
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
# Claim carrying the user's groups, and the group→role map. '*' catches
# authenticated users with no mapped group; omit '*' to deny them.
SSO_OIDC_GROUP_CLAIM=groups
SSO_ROLE_MAP=*=viewer
# Label on the login button, e.g. "Keycloak".
SSO_OIDC_LABEL=Single sign-on
# LDAP / Active Directory (optional). Local users always take precedence.
SSO_LDAP_URL=
SSO_LDAP_BIND_DN=
SSO_LDAP_BIND_PASSWORD=
SSO_LDAP_SEARCH_BASE=
SSO_LDAP_USER_FILTER=(uid={username})
SSO_LDAP_USERNAME_ATTR=uid

# ── Notifications (alerting dispatch) ──────────────────────────────────────
# One page per incident per cooldown (seconds); escalations bypass it.
NOTIFY_COOLDOWN_S=300
# Optional catch-all webhook so a fresh install pages somewhere before any
# alert_rules are configured (Slack-style JSON {text} works too via a rule).
NOTIFY_FALLBACK_WEBHOOK=

# ── Nagios Core integration ────────────────────────────────────────────────
# Path to the Nagios status file (updated by Nagios every status_update_interval)
NAGIOS_STATUS_FILE=/usr/local/nagios/var/status.dat
# Path to the Nagios external command file (named pipe) for acks/downtime/rechecks
NAGIOS_COMMAND_FILE=/usr/local/nagios/var/rw/nagios.cmd
# How often (ms) the connector checks status.dat for changes
NAGIOS_POLL_INTERVAL=5000
# Optional: mk-livestatus unix socket (preferred over status.dat when present)
NAGIOS_LIVESTATUS_SOCKET=

# ── Anomaly detection (dynamic thresholds) ─────────────────────────────────
# Deterministic median+MAD baselines per device+metric; anomalies open
# explainable warning alerts and auto-resolve. Set false to disable.
ANOMALY_ENABLED=true
ANOMALY_SWEEP_MS=300000
ANOMALY_Z_THRESHOLD=4
ANOMALY_MIN_DELTA_PCT=10
ANOMALY_HISTORY_DAYS=7

# ── Poller / connectors ────────────────────────────────────────────────────
POLLER_CONCURRENCY=32
SNMP_DEFAULT_COMMUNITY=public
# LLDP auto-topology sweep interval (ms)
LLDP_INTERVAL_MS=3600000
MERAKI_API_KEY=
MERAKI_BASE_URL=https://api.meraki.com/api/v1
MERAKI_ORG_ID=
WINRM_DEFAULT_USER=
WINRM_DEFAULT_PASSWORD=
ASTERISK_AMI_HOST=
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=
ASTERISK_AMI_PASSWORD=
