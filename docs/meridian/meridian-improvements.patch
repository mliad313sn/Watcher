diff --git a/server/migrations/034_work_links.sql b/server/migrations/034_work_links.sql
new file mode 100644
index 0000000..e8194a6
--- /dev/null
+++ b/server/migrations/034_work_links.sql
@@ -0,0 +1,77 @@
+-- ═══════════════════════════════════════════════════════════════════
+-- 034 · LE PONT VERS LÀ OÙ LE TRAVAIL SE FAIT  (INT-10)
+--
+-- Le constat le plus dur du comité de marché, et celui qui décide d'une
+-- adoption : Meridian n'est pas l'endroit où le travail se fait, et il
+-- n'avait aucun pont vers l'endroit où il se fait. L'équipe livre dans
+-- Jira, Azure DevOps ou GitHub ; l'avancement était donc saisi DEUX fois.
+-- Et un avancement re-saisi est un avancement périmé — c'est ainsi qu'un
+-- outil de PMO cesse d'être tenu à jour, puis cesse d'être cru.
+--
+-- `server/src/routes/v1.js` annonçait exactement ceci : « les écritures
+-- viendront avec les intégrations qui les demandent, jamais avant ».
+-- C'est l'intégration qui les demande.
+--
+-- ── Ce qui est délibérément REFUSÉ ────────────────────────────────
+--
+-- Pas de connecteur Jira. Pas de connecteur Azure DevOps. Le comité
+-- d'interopérabilité a tranché « quatre surfaces plutôt que vingt
+-- connecteurs », et il avait raison : vingt connecteurs, ce sont vingt
+-- dettes d'authentification, vingt formats qui changent sans prévenir, et
+-- vingt raisons de ne pas mettre à jour le produit. Ce qui s'ajoute ici
+-- est UNE surface générique que n'importe quel suivi de tâches sait
+-- appeler, avec sa propre clé et sa propre portée.
+--
+-- ── L'AUTORITÉ reste où elle était ────────────────────────────────
+--
+-- Le lien entre un élément externe et une étape est créé par une
+-- PERSONNE, avec une session, sous `schedule.write` du projet concerné.
+-- L'intégration ne peut que RAPPORTER l'état d'un lien qui existe déjà.
+--
+-- C'est la règle du produit appliquée sans exception : une clé volée ne
+-- doit pas pouvoir rattacher du travail inventé à n'importe quelle étape
+-- d'un portefeuille, ni décider qu'un projet est terminé. Elle ne peut
+-- dire que « ce ticket, que quelqu'un a déjà rattaché ici, est fermé ».
+--
+-- ── Pourquoi l'avancement se DÉDUIT au lieu d'être écrit ──────────
+--
+-- L'intégration n'envoie jamais un pourcentage. Elle envoie des états
+-- d'éléments ; le pourcentage de l'étape est le rapport des éléments
+-- fermés sur les éléments liés. Un système externe qui pourrait écrire
+-- « 90 % » directement rendrait la valeur invérifiable — alors que
+-- « 9 tickets sur 10 » se relit, se conteste, et se rattache à des
+-- objets qu'un auditeur peut aller voir.
+
+CREATE TABLE work_link (
+  id             text PRIMARY KEY,
+  activity_id    text NOT NULL REFERENCES activity(id) ON DELETE CASCADE,
+  -- « jira », « ado », « github »… nommé par celui qui crée le lien ; le
+  -- produit n'a pas de liste fermée, et n'en veut pas.
+  system         text NOT NULL,
+  -- L'identifiant stable côté source (un id numérique, un GUID). C'est lui
+  -- qui sert de clé, jamais la référence lisible : celle-ci change quand un
+  -- ticket est déplacé de projet, et le lien serait alors perdu.
+  external_id    text NOT NULL,
+  -- La référence lisible (« OPS-1423 »), pour que l'écran montre ce que
+  -- l'équipe dit à voix haute.
+  external_key   text NOT NULL DEFAULT '',
+  title          text NOT NULL DEFAULT '',
+  url            text NOT NULL DEFAULT '',
+  -- « open » | « closed ». Deux états, parce que c'est tout ce dont le
+  -- calcul a besoin : les colonnes intermédiaires d'un tableau d'équipe
+  -- sont l'affaire de l'équipe, pas celle du portefeuille.
+  state          text NOT NULL DEFAULT 'open' CHECK (state IN ('open', 'closed')),
+  closed_on      date,
+  created_by     text REFERENCES app_user(id) ON DELETE SET NULL,
+  created_at     timestamptz NOT NULL DEFAULT now(),
+  -- Qui a rapporté l'état pour la dernière fois, et quand.
+  reported_by    text REFERENCES integration(id) ON DELETE SET NULL,
+  reported_at    timestamptz,
+  row_version    integer NOT NULL DEFAULT 1,
+  -- Un élément externe ne se rattache qu'à une étape : deux étapes qui se
+  -- partagent le même ticket, ce sont deux avancements qui se contredisent.
+  UNIQUE (system, external_id)
+);
+CREATE INDEX work_link_activity_idx ON work_link(activity_id);
+
+INSERT INTO id_counter (prefix, next_value) VALUES ('WL', 0);
