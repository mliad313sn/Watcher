     const out = await audited(req.user,
       { action: b.status === "Closed" ? "Item closed" : "Item updated",
-        entity: "raid_item", entityId: item.id, detail: b.title ?? item.title },
+        entity: "raid_item", entityId: item.id, detail: b.title ?? item.title,
+        /* "Who closed this risk, and what did it say before?" is the first
+           question asked of a register at review. Deletion carried a
+           before-image and closure did not, which is the wrong way round:
+           register items are closed constantly and deleted almost never. */
