diff --git a/server/src/db.js b/server/src/db.js
index 73c5c8e..1df883a 100644
--- a/server/src/db.js
+++ b/server/src/db.js
@@ -9,6 +9,7 @@
  * runs in production. Nothing above this file knows which is in use.
  */
 
+import { mkdirSync } from "node:fs";
 import { readdir, readFile } from "node:fs/promises";
 import { dirname, join } from "node:path";
 import { fileURLToPath } from "node:url";
@@ -148,6 +149,9 @@ async function clearStaleLocks(dataDir) {
 
 async function openPglite(dataDir) {
   const { PGlite } = await import("@electric-sql/pglite");
+  /* PGlite creates the last path element, not the whole path, so a data
+     directory whose parent is missing fails with ENOENT before it opens. */
+  if (dataDir) mkdirSync(dataDir, { recursive: true });
   await clearStaleLocks(dataDir);
   const pglite = dataDir ? new PGlite(dataDir) : new PGlite();
   await pglite.waitReady;
@@ -220,10 +224,31 @@ async function openPglite(dataDir) {
 
 /* ── lifecycle ────────────────────────────────────────────────────── */
 
+/* The directory README.md promises: "with no DATABASE_URL the server runs
+   PGlite from server/.data/pgdata". It did not, because nothing loads
+   `.env` — `dotenv` is not a dependency and is imported nowhere — so
+   PGLITE_DIR was never set and the fallback was an in-memory database. The
+   consequence was silent and total: `npm run seed` seeded a database that
+   died with the process, `npm run dev` then opened a fresh empty one, and
+   the sign-in screen offered no accounts at all. Following the three
+   commands in the README produced an instance with nothing in it.
+
+   Resolved from this file rather than from the working directory, so it is
+   the same database whichever command is run and from wherever. */
+const DEFAULT_PGLITE_DIR = join(HERE, "..", ".data", "pgdata");
+
 export async function connect(opts = {}) {
   const url = opts.url ?? process.env.DATABASE_URL;
-  if (url) impl = await openPg(url);
-  else impl = await openPglite(opts.dataDir ?? process.env.PGLITE_DIR ?? null);
+  if (url) { impl = await openPg(url); }
+  else {
+    /* An explicitly passed dataDir wins — including `null`, which is how the
+       audit harnesses ask for a throwaway in-memory instance and must keep
+       doing, or a sweep would overwrite the real book. */
+    const dataDir = "dataDir" in opts
+      ? opts.dataDir
+      : (process.env.PGLITE_DIR || DEFAULT_PGLITE_DIR);
+    impl = await openPglite(dataDir);
+  }
   engineName = impl.name;
   return impl;
 }
