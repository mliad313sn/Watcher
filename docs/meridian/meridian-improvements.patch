new file mode 100644
index 0000000..9bff05d
--- /dev/null
+++ b/server/test/worklink.test.js
@@ -0,0 +1,370 @@
+/**
+ * INT-10 · Le pont vers là où le travail se fait.
+ *
+ * Le constat qui décide d'une adoption : l'équipe livre dans Jira ou Azure
+ * DevOps, et l'avancement était saisi deux fois. Un avancement re-saisi est
+ * un avancement périmé — c'est ainsi qu'un outil de PMO cesse d'être tenu à
+ * jour, puis cesse d'être cru.
+ *
+ * Ces tests tiennent les cinq propriétés qui rendent le pont sûr, et chacune
+ * est un refus :
+ *
+ *   · une clé ne RATTACHE pas — rattacher est un acte de session, sous
+ *     l'autorité du projet ;
+ *   · une clé n'écrit pas un POURCENTAGE — elle rapporte des états, et
+ *     l'avancement se déduit ;
+ *   · une clé de lecture ne rapporte rien ;
+ *   · un élément inconnu revient dans `unlinked`, jamais en silence ;
+ *   · une étape qu'une personne a modifiée entre-temps n'est pas écrasée.
+ */
+
+import { test, before, after, describe } from "node:test";
+import assert from "node:assert/strict";
+import { boot, shutdown, as, client } from "./harness.js";
+import { one, many } from "../src/db.js";
+import { SCOPES } from "../src/integrations.js";
+
+before(async () => { await boot(); });
+after(shutdown);
+
+async function mint(admin, name, scopes) {
+  const r = await admin.post("/api/admin/integrations", { name, scopes, purpose: "test" });
+  assert.equal(r.status, 201, r.text);
+  return r.body;
+}
+
+/** Un appel machine : pas de cookie, une clé dans l'en-tête. */
+function machine(key) {
+  const c = client();
+  return {
+    post: (path, body) => c.post(path, body, { "X-API-Key": key }),
+    get: (path) => c.get(path, { "X-API-Key": key }),
+  };
+}
+
+/* Une étape par test, jamais la même deux fois : des liens laissés par un
+   test précédent changeraient l'arithmétique du suivant, et l'échec se
+   lirait comme un défaut du produit. */
+let taken = 0;
+async function freshStage() {
+  const rows = await many(
+    `SELECT a.* FROM activity a JOIN project p ON p.id = a.project_id
+      WHERE p.origin = 'local' AND a.id NOT IN (SELECT activity_id FROM work_link)
+      ORDER BY a.id`);
+  const a = rows[taken++ % rows.length];
+  assert.ok(a, "le jeu de démonstration porte assez d'étapes");
+  return a;
+}
+
+/* Une étape remise à zéro d'abord. Une étape du jeu de démonstration qui se
+   trouve DÉJÀ au pourcentage que le rapport calculerait ne bouge pas — et
+   c'est le comportement voulu, pas un défaut : un rapport qui ne change rien
+   n'écrit rien et n'audite rien. Un test de la trace doit donc partir d'une
+   valeur connue, sinon il mesure le hasard du jeu de données. */
+async function zeroedStage(admin) {
+  const a = await freshStage();
+  const r = await admin.patch(`/api/activities/${a.id}`, { pct: 0, version: a.row_version });
+  assert.equal(r.status, 200, r.text);
+  return { ...a, pct: 0, row_version: r.body.version };
+}
+
+describe("INT-10 · l'autorité de rattacher", () => {
+  test("la portée d'écriture existe, et elle ne dit pas « pourcentage »", () => {
+    assert.ok(SCOPES["write:progress"], "la portée est déclarée");
+    assert.match(SCOPES["write:progress"], /never a percentage/i);
+  });
+
+  test("une personne rattache un élément à une étape, et cela s'audite", async () => {
+    const admin = await as("admin");
+    const stage = await freshStage();
+
+    const made = await admin.post("/api/worklinks", {
+      activity: stage.id, system: "jira", externalId: "10001",
+      externalKey: "OPS-1423", title: "Close the ingest gap",
+    });
+    assert.equal(made.status, 201, made.text);
+
+    const row = await one(`SELECT * FROM work_link WHERE id = $1`, [made.body.id]);
+    assert.equal(row.activity_id, stage.id);
+    assert.equal(row.state, "open", "un élément rattaché est ouvert jusqu'à preuve du contraire");
+
+    const audit = await admin.get("/api/audit?entity=work_link");
+    const event = audit.body.events.find((e) => e.entity_id === made.body.id);
+    assert.ok(event, "le rattachement laisse une trace");
+    assert.match(event.action, /linked/i);
+  });
+
+  test("un élément ne se rattache qu'à une étape", async () => {
+    // Deux étapes qui se partagent un ticket, ce sont deux avancements qui
+    // se contredisent.
+    const admin = await as("admin");
+    const stage = await freshStage();
+    const first = await admin.post("/api/worklinks", {
+      activity: stage.id, system: "jira", externalId: "dup-1", externalKey: "OPS-1",
+    });
+    assert.equal(first.status, 201);
+    const again = await admin.post("/api/worklinks", {
+      activity: stage.id, system: "jira", externalId: "dup-1", externalKey: "OPS-1",
+    });
+    assert.equal(again.status, 400);
+    assert.match(again.body.error, /already linked/i);
+  });
+
+  test("un lecteur ne rattache rien, même sur un projet qu'il voit", async () => {
+    /* Sur un projet qu'il ne voit PAS, la réponse est 404 — le produit ne
+       confirme pas l'existence de ce qu'on n'a pas le droit de lire. Le
+       refus intéressant est donc celui-ci : il voit le projet, et il ne
+       peut toujours pas y accrocher du travail. */
+    const viewer = await as("viewerGRU");
+    const stage = await one(
+      `SELECT a.* FROM activity a JOIN project p ON p.id = a.project_id
+        WHERE p.origin = 'local' AND p.site_id = 'GRU' ORDER BY a.id LIMIT 1`);
+    assert.ok(stage, "le lecteur de São Paulo voit au moins un projet");
+
+    const r = await viewer.post("/api/worklinks", {
+      activity: stage.id, system: "jira", externalId: "nope-1",
+    });
+    assert.equal(r.status, 403, r.text);
+    assert.equal(await one(`SELECT * FROM work_link WHERE external_id = 'nope-1'`), null);
+  });
+});
+
+describe("INT-10 · ce que la clé peut, et ce qu'elle ne peut pas", () => {
+  test("elle ne rattache pas : /api n'est pas ouvert à une clé", async () => {
+    // C'est la propriété qui fait qu'une clé volée ne peut pas accrocher du
+    // travail inventé à n'importe quelle étape d'un portefeuille.
+    const admin = await as("admin");
+    const key = await mint(admin, "Jira sync (rattachement)", "write:progress");
+    const stage = await freshStage();
+
+    const r = await machine(key.key).post("/api/worklinks", {
+      activity: stage.id, system: "jira", externalId: "forbidden-1",
+    });
+    assert.equal(r.status, 401, "l'interface interactive refuse une clé");
+  });
+
+  test("une clé de lecture ne rapporte pas d'avancement", async () => {
+    const admin = await as("admin");
+    const key = await mint(admin, "Entrepôt (lecture seule)", "read:portfolio");
+    const r = await machine(key.key).post("/api/v1/progress", {
+      system: "jira", items: [{ externalId: "10001", state: "closed" }],
+    });
+    assert.equal(r.status, 403);
+    assert.match(r.body.error, /write:progress/);
+  });
+
+  test("aucune clé du tout est refusée", async () => {
+    const c = client();
+    const r = await c.post("/api/v1/progress", { system: "jira", items: [] });
+    assert.equal(r.status, 401);
+  });
+});
+
+describe("INT-10 · l'avancement se déduit", () => {
+  test("le pourcentage est le rapport des fermés sur les liés, jamais une valeur reçue", async () => {
+    const admin = await as("admin");
+    const key = await mint(admin, "Jira sync", "write:progress");
+    const stage = await freshStage();
+
+    // Quatre éléments rattachés par une personne.
+    for (const n of [1, 2, 3, 4]) {
+      const r = await admin.post("/api/worklinks", {
+        activity: stage.id, system: "ado", externalId: `calc-${n}`, externalKey: `AB#${n}`,
+      });
+      assert.equal(r.status, 201, r.text);
+    }
+
+    // Le suivi de tâches en ferme trois.
+    const report = await machine(key.key).post("/api/v1/progress", {
+      system: "ado",
+      items: [
+        { externalId: "calc-1", state: "closed" },
+        { externalId: "calc-2", state: "closed" },
+        { externalId: "calc-3", state: "closed" },
+        { externalId: "calc-4", state: "open" },
+      ],
+    });
+    assert.equal(report.status, 200, report.text);
+
+    const moved = report.body.updated.find((u) => u.activity === stage.id);
+    assert.ok(moved, "l'étape a bougé");
+    assert.equal(moved.now, 75, "trois sur quatre");
+    assert.equal(moved.closed, 3);
+    assert.equal(moved.of, 4);
+
+    const after = await one(`SELECT pct FROM activity WHERE id = $1`, [stage.id]);
+    assert.equal(after.pct, 75, "et la valeur est bien celle qui est écrite");
+  });
+
+  test("un pourcentage envoyé par l'intégration est ignoré", async () => {
+    // Une valeur reçue serait invérifiable ; « 3 sur 4 » se relit et se
+    // rattache à des objets qu'un auditeur peut aller voir.
+    const admin = await as("admin");
+    const key = await mint(admin, "Jira sync (menteur)", "write:progress");
+    const stage = await freshStage();
+    await admin.post("/api/worklinks", {
+      activity: stage.id, system: "gh", externalId: "liar-1", externalKey: "#1",
+    });
+
+    await machine(key.key).post("/api/v1/progress", {
+      system: "gh", pct: 100, percent: 100,
+      items: [{ externalId: "liar-1", state: "open", pct: 100 }],
+    });
+    const after = await one(`SELECT pct FROM activity WHERE id = $1`, [stage.id]);
+    assert.equal(after.pct, 0, "aucun élément fermé, donc zéro, quoi qu'on ait envoyé");
+  });
+
+  test("un élément inconnu revient dans unlinked, jamais en silence", async () => {
+    const admin = await as("admin");
+    const key = await mint(admin, "Jira sync (inconnu)", "write:progress");
+    const r = await machine(key.key).post("/api/v1/progress", {
+      system: "jira",
+      items: [{ externalId: "never-seen-1", state: "closed" },
+              { externalId: "never-seen-2", state: "open" }],
+    });
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.body.unlinked.sort(), ["never-seen-1", "never-seen-2"]);
+    assert.equal(r.body.updated.length, 0);
+  });
+
+  test("un rapport identique au précédent ne bouge rien et ne s'audite pas", async () => {
+    const admin = await as("admin");
+    const key = await mint(admin, "Jira sync (répétition)", "write:progress");
+    const stage = await freshStage();
+    await admin.post("/api/worklinks", {
+      activity: stage.id, system: "rep", externalId: "same-1", externalKey: "R-1",
+    });
+    const body = { system: "rep", items: [{ externalId: "same-1", state: "closed" }] };
+
+    await machine(key.key).post("/api/v1/progress", body);
+    const before = (await admin.get("/api/audit?action=Progress reported")).body.events.length;
+
+    const second = await machine(key.key).post("/api/v1/progress", body);
+    assert.equal(second.body.updated.length, 0, "rien à changer");
+    assert.equal(second.body.unchanged, 1);
+
+    const after = (await admin.get("/api/audit?action=Progress reported")).body.events.length;
+    assert.equal(after, before, "et rien de plus dans la piste");
+  });
+
+  test("rouvrir un élément fait redescendre l'avancement", async () => {
+    const admin = await as("admin");
+    const key = await mint(admin, "Jira sync (réouverture)", "write:progress");
+    const stage = await freshStage();
+    for (const n of [1, 2]) {
+      await admin.post("/api/worklinks", {
+        activity: stage.id, system: "ro", externalId: `ro-${n}`, externalKey: `RO-${n}`,
+      });
+    }
+    await machine(key.key).post("/api/v1/progress", {
+      system: "ro",
+      items: [{ externalId: "ro-1", state: "closed" }, { externalId: "ro-2", state: "closed" }],
+    });
+    assert.equal((await one(`SELECT pct FROM activity WHERE id = $1`, [stage.id])).pct, 100);
+
+    const back = await machine(key.key).post("/api/v1/progress", {
+      system: "ro", items: [{ externalId: "ro-1", state: "open" }],
+    });
+    assert.equal(back.body.updated[0].now, 50, "un ticket rouvert est du travail à refaire");
+  });
+});
+
+describe("INT-10 · la trace", () => {
+  test("l'avancement rapporté nomme l'intégration, jamais « système »", async () => {
+    // 025 : « un NOM dans la piste d'audit. "système" n'est pas une réponse
+    // à "qui a écrit cette ligne" ».
+    const admin = await as("admin");
+    const key = await mint(admin, "Azure DevOps — plateforme", "write:progress");
+    const stage = await zeroedStage(admin);
+    await admin.post("/api/worklinks", {
+      activity: stage.id, system: "named", externalId: "n-1", externalKey: "N-1",
+    });
+    await machine(key.key).post("/api/v1/progress", {
+      system: "named", items: [{ externalId: "n-1", state: "closed" }],
+    });
+
+    const audit = await admin.get("/api/audit?action=Progress reported");
+    const event = audit.body.events.find((e) => e.entity_id === stage.id);
+    assert.ok(event, "le mouvement est tracé");
+    assert.match(event.user_label, /Azure DevOps — plateforme/);
+    assert.match(event.detail, /1\/1 item\(s\) closed/);
+  });
+
+  test("et il porte l'image d'avant, comme toute mise à jour", async () => {
+    const admin = await as("admin");
+    const key = await mint(admin, "Jira sync (image)", "write:progress");
+    const stage = await zeroedStage(admin);
+    await admin.post("/api/worklinks", {
+      activity: stage.id, system: "img", externalId: "i-1", externalKey: "I-1",
+    });
+    const was = (await one(`SELECT pct FROM activity WHERE id = $1`, [stage.id])).pct;
+
+    await machine(key.key).post("/api/v1/progress", {
+      system: "img", items: [{ externalId: "i-1", state: "closed" }],
+    });
+    const audit = await admin.get("/api/audit?action=Progress reported");
+    const event = audit.body.events.find((e) => e.entity_id === stage.id);
+    assert.ok(event.before_json, "l'image d'avant est là");
+    assert.equal(event.before_json.pct, was, "et c'est bien la valeur d'avant");
+  });
+
+  test("délier retire le lien et garde la trace de ce qu'il disait", async () => {
+    const admin = await as("admin");
+    const stage = await freshStage();
+    const made = await admin.post("/api/worklinks", {
+      activity: stage.id, system: "del", externalId: "d-1", externalKey: "D-1",
+      title: "Something worth remembering",
+    });
+    const gone = await admin.del(`/api/worklinks/${made.body.id}`);
+    assert.equal(gone.status, 200);
+    assert.equal(await one(`SELECT * FROM work_link WHERE id = $1`, [made.body.id]), null);
+
+    const audit = await admin.get("/api/audit?entity=work_link");
+    const event = audit.body.events.find(
+      (e) => e.entity_id === made.body.id && /unlinked/i.test(e.action));
+    assert.ok(event, "le retrait est tracé");
+    assert.equal(event.before_json.title, "Something worth remembering");
+  });
+});
+
+describe("INT-10 · les bornes", () => {
+  test("un rapport sans système est refusé", async () => {
+    const admin = await as("admin");
+    const key = await mint(admin, "Jira sync (sans nom)", "write:progress");
+    const r = await machine(key.key).post("/api/v1/progress", { items: [] });
+    assert.equal(r.status, 400);
+  });
+
+  test("un rapport sans items est refusé", async () => {
+    const admin = await as("admin");
+    const key = await mint(admin, "Jira sync (sans items)", "write:progress");
+    const r = await machine(key.key).post("/api/v1/progress", { system: "jira" });
+    assert.equal(r.status, 400);
+  });
+
+  test("un lot démesuré est refusé plutôt que servi", async () => {
+    const admin = await as("admin");
+    const key = await mint(admin, "Jira sync (lot)", "write:progress");
+    const items = Array.from({ length: 1001 }, (_, i) => ({ externalId: `x${i}`, state: "open" }));
+    const r = await machine(key.key).post("/api/v1/progress", { system: "jira", items });
+    assert.equal(r.status, 400);
+    assert.match(r.body.error, /1000/);
+  });
+
+  test("délier une étape ne touche pas les liens des autres", async () => {
+    const admin = await as("admin");
+    const stages = await many(
+      `SELECT a.* FROM activity a JOIN project p ON p.id = a.project_id
+        WHERE p.origin = 'local' ORDER BY a.id LIMIT 2`);
+    const [one_, two] = stages;
+    await admin.post("/api/worklinks", {
+      activity: one_.id, system: "iso", externalId: "iso-1", externalKey: "S-1" });
+    const keep = await admin.post("/api/worklinks", {
+      activity: two.id, system: "iso", externalId: "iso-2", externalKey: "S-2" });
+
+    const links = await many(`SELECT * FROM work_link WHERE system = 'iso'`);
+    assert.equal(links.length, 2);
