+    if (items.length > 1000) {
+      throw new HttpError(400, "At most 1000 items per report — page it");
+    }
+
+    const unlinked = [];
+    const touched = new Map();          // activity_id → { before, after }
+    let unchanged = 0;
+
+    for (const item of items) {
+      const externalId = String(item?.externalId ?? "").trim();
+      if (!externalId) continue;
+      const state = item?.state === "closed" ? "closed" : "open";
+
+      const link = await one(
+        `SELECT * FROM work_link WHERE system = $1 AND external_id = $2`,
+        [system, externalId]);
+      if (!link) { unlinked.push(externalId); continue; }
+
+      if (link.state === state
+          && link.external_key === (item.key ?? link.external_key)
+          && link.title === (item.title ?? link.title)) {
+        unchanged++;
+        touched.set(link.activity_id, true);
+        continue;
+      }
+
+      await query(
+        `UPDATE work_link
+            SET state = $2, closed_on = $3, external_key = $4, title = $5, url = $6,
+                reported_by = $7, reported_at = now(), row_version = row_version + 1
+          WHERE id = $1`,
+        [link.id, state, state === "closed" ? new Date() : null,
+         item.key ?? link.external_key, item.title ?? link.title,
+         item.url ?? link.url, req.integration.id]);
+      touched.set(link.activity_id, true);
+    }
+
+    /* Un seul mouvement d'avancement par étape touchée, audité avec le NOM
+       de l'intégration : « système » n'est pas une réponse à « qui a écrit
+       cette ligne » (025). */
+    const updated = [];
+    const contended = [];
+    for (const activityId of touched.keys()) {
+      const counts = await one(
+        `SELECT count(*)::int AS total,
+                count(*) FILTER (WHERE state = 'closed')::int AS closed
+           FROM work_link WHERE activity_id = $1`, [activityId]);
+      if (!counts || !counts.total) continue;
+
+      const pct = Math.round((counts.closed / counts.total) * 100);
+      const activity = await one(`SELECT * FROM activity WHERE id = $1`, [activityId]);
+      if (!activity || activity.pct === pct) continue;
+
+      const out = await audited(req.user,
+        { action: "Progress reported", entity: "activity", entityId: activityId,
+          detail: `${activity.name} — ${counts.closed}/${counts.total} item(s) closed `
+                + `(${activity.pct}% → ${pct}%), reported by ${system}` },
+        async (t) => updateVersioned(
+          t, "activity", activityId, activity.row_version, { pct }));
+
+      /* Une personne a modifié l'étape entre la lecture et l'écriture. Pour
+         un humain c'est un 409 « rechargez » ; pour une machine qui poste
+         un lot, refuser tout le lot à cause d'une ligne serait absurde —
+         l'étape est signalée `contended` et le rapport suivant la reprendra
+         avec la version à jour. Ce qui ne doit jamais arriver, et n'arrive
+         pas, c'est l'écrasement silencieux. */
+      if (!out.ok) { contended.push(activityId); continue; }
+
+      updated.push({
+        activity: activityId, name: activity.name,
+        was: activity.pct, now: pct,
+        closed: counts.closed, of: counts.total,
+      });
+    }
+
+    res.json({ ...stamp(), updated, unlinked, unchanged, contended });
+  } catch (e) { next(e); }
+});
