From d871e9711ecee1a34d6690fdc1fd2b623f3f2a6e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 8 Sep 2026 22:23:27 +0000
Subject: [PATCH] Fix the first-run blocker, and record before-images on
 register updates
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Two findings from using Meridian to run a real delivery programme — five
projects, seventeen stages, four gates each, nine RAID items — over a
working day.

1. Following README.md exactly produces an empty instance.

   The README says: "With no DATABASE_URL the server runs PGlite from
   server/.data/pgdata". It does not. `.env.example` sets PGLITE_DIR, but
   nothing loads `.env` — dotenv is not a dependency and is imported
   nowhere — so PGLITE_DIR is unset and the fallback is an in-memory
   database.

   The failure is silent and total. `npm run seed` reports "seeded 12
   projects · 10 users" and that database dies with the process; `npm run
   dev` opens a fresh empty one; the sign-in screen offers no accounts
   (/api/auth/accounts returns seeded:false) and every documented password
   is refused. Nothing in the output suggests what happened.

   Fixed by making the code do what the README says: the default data
   directory is server/.data/pgdata, resolved from db.js rather than from
   the working directory so all three commands agree wherever they are run
   from. An explicitly passed dataDir still wins, including `null` — that
   is how view-render and usecase-sweep ask for a throwaway in-memory
   instance, and they must keep getting one or a sweep would overwrite the
   real book.

   Also: PGlite creates the last path element only, so a data directory
   whose parent is missing fails with ENOENT before it opens. mkdir -p
   first.

2. Closing a register item recorded no before-image.

   audit_event carries before_json/after_json and record() writes them, but
   among the audited() call sites they are passed on deletions and on a few
   exceptional acts (gate override, re-baseline) — not on ordinary updates.
   Over 181 audit rows written by the campaign above, none carried a
   before-image, including eight "Item closed" rows.

   That is the wrong way round for a register: items are closed constantly
   and deleted almost never, and "who closed this risk, and what did it say
   before?" is the first question asked at review. The trail could say a
   risk was closed and by whom, but not what it had been.

   PATCH /api/raid/:id now passes the prior status, title, detail,
   probability, impact, response and owner, plus the patch as the after-
   image. The same gap remains on other update routes and is worth the same
   treatment; this fixes the one that matters most.

Verified: 449 tests pass, the nine audit gates pass, the build passes, and
a clean clone now reaches a signed-in session with `npm install && npm run
seed && npm run dev` and no environment variables.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UAjZnbKQNX8rHutySV6b3R
---
 server/src/db.js               | 29 +++++++++++++++++++++++++++--
 server/src/routes/portfolio.js | 12 +++++++++++-
 2 files changed, 38 insertions(+), 3 deletions(-)

diff --git a/server/src/db.js b/server/src/db.js
index 73c5c8e..1df883a 100644
--- a/server/src/db.js
+++ b/server/src/db.js
@@ -9,6 +9,7 @@
  * runs in production. Nothing above this file knows which is in use.
  */
 
+import { mkdirSync } from "node:fs";
 import { readdir, readFile } from "node:fs/promises";
 import { dirname, join } from "node:path";
 import { fileURLToPath } from "node:url";
@@ -148,6 +149,9 @@ async function clearStaleLocks(dataDir) {
 
 async function openPglite(dataDir) {
   const { PGlite } = await import("@electric-sql/pglite");
+  /* PGlite creates the last path element, not the whole path, so a data
+     directory whose parent is missing fails with ENOENT before it opens. */
+  if (dataDir) mkdirSync(dataDir, { recursive: true });
   await clearStaleLocks(dataDir);
   const pglite = dataDir ? new PGlite(dataDir) : new PGlite();
   await pglite.waitReady;
@@ -220,10 +224,31 @@ async function openPglite(dataDir) {
 
 /* ── lifecycle ────────────────────────────────────────────────────── */
 
+/* The directory README.md promises: "with no DATABASE_URL the server runs
+   PGlite from server/.data/pgdata". It did not, because nothing loads
+   `.env` — `dotenv` is not a dependency and is imported nowhere — so
+   PGLITE_DIR was never set and the fallback was an in-memory database. The
+   consequence was silent and total: `npm run seed` seeded a database that
+   died with the process, `npm run dev` then opened a fresh empty one, and
+   the sign-in screen offered no accounts at all. Following the three
+   commands in the README produced an instance with nothing in it.
+
+   Resolved from this file rather than from the working directory, so it is
+   the same database whichever command is run and from wherever. */
+const DEFAULT_PGLITE_DIR = join(HERE, "..", ".data", "pgdata");
+
 export async function connect(opts = {}) {
   const url = opts.url ?? process.env.DATABASE_URL;
-  if (url) impl = await openPg(url);
-  else impl = await openPglite(opts.dataDir ?? process.env.PGLITE_DIR ?? null);
+  if (url) { impl = await openPg(url); }
+  else {
+    /* An explicitly passed dataDir wins — including `null`, which is how the
+       audit harnesses ask for a throwaway in-memory instance and must keep
+       doing, or a sweep would overwrite the real book. */
+    const dataDir = "dataDir" in opts
+      ? opts.dataDir
+      : (process.env.PGLITE_DIR || DEFAULT_PGLITE_DIR);
+    impl = await openPglite(dataDir);
+  }
   engineName = impl.name;
   return impl;
 }
diff --git a/server/src/routes/portfolio.js b/server/src/routes/portfolio.js
index 76861f3..afca211 100644
--- a/server/src/routes/portfolio.js
+++ b/server/src/routes/portfolio.js
@@ -853,7 +853,17 @@ r.patch("/raid/:id", async (req, res, next) => {
 
     const out = await audited(req.user,
       { action: b.status === "Closed" ? "Item closed" : "Item updated",
-        entity: "raid_item", entityId: item.id, detail: b.title ?? item.title },
+        entity: "raid_item", entityId: item.id, detail: b.title ?? item.title,
+        /* "Who closed this risk, and what did it say before?" is the first
+           question asked of a register at review. Deletion carried a
+           before-image and closure did not, which is the wrong way round:
+           register items are closed constantly and deleted almost never. */
+        before: {
+          status: item.status, title: item.title, detail: item.detail,
+          probability: item.probability, impact: item.impact,
+          response: item.response, owner_id: item.owner_id,
+        },
+        after: patch },
       async (t) => conflict(await updateVersioned(t, "raid_item", item.id, requiredVersion(b, "register item"), patch)));
     res.json({ version: out.version });
   } catch (e) { next(e); }
